# KIS API (한국투자증권)
KIS_APP_KEY=your_app_key_here
KIS_APP_SECRET=your_app_secret_here
KIS_ACCOUNT_NO=your_account_number  # 계좌번호 (XXXXXXXX-XX)
KIS_IS_REAL=false  # true=실전, false=모의투자

# Auth
SECRET_KEY=your-very-long-random-secret-key-change-this
TOTP_ISSUER=StockApp

# External APIs
FINNHUB_API_KEY=your_finnhub_key  # finnhub.io 무료 가입
DART_API_KEY=your_dart_key        # opendart.fss.or.kr 무료 가입
FRED_API_KEY=your_fred_key        # fred.stlouisfed.org 무료 가입

# 메일 발송 — 회원가입·비밀번호 찾기 인증 코드 (없으면 회원가입·비밀번호 찾기만 안 됨)
# 네이버: 메일 → 환경설정 → POP3/IMAP 설정 → SMTP 사용 '사용함'. 네이버 2단계 인증을 쓰면 SMTP_PASSWORD 에 '애플리케이션 비밀번호'
SMTP_HOST=smtp.naver.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SIGNUP_OPEN=true
# 초대 코드가 있어야 가입 (관리자가 마이페이지 → 관리자에서 만듦, 1회용). false 면 인증만 하면 누구나 가입
INVITE_ONLY=true
# 2단계 인증(Google Authenticator) 필수 — 켜기 전에는 2단계 등록 화면만 쓸 수 있음. 인터넷에 연 서버에서는 끄지 말 것
REQUIRE_TOTP=true

# 휴대폰 문자 인증 (선택 — 이메일 대신 휴대폰으로 본인인증). 솔라피 solapi.com 가입·충전 → 콘솔에서 API Key 발급 + 발신번호 등록
# SMS_FROM 은 솔라피에 등록·인증한 번호여야 함 (내 휴대폰 번호 가능). 비워 두면 휴대폰 인증 탭만 '준비 안 됨'
SMS_API_KEY=
SMS_API_SECRET=
SMS_FROM=
SMS_DAILY_LIMIT=50

# App
APP_ENV=development
FRONTEND_URL=http://localhost:5173
