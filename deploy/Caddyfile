# DOMAIN 은 deploy/.env 에서 (예: mystock.duckdns.org) — 도메인이면 Let's Encrypt 인증서를 자동으로 받음
{$DOMAIN} {
	encode gzip

	# 앱 로그인 앞에 비밀번호 한 겹 더 (인터넷 공개라서) — 계정은 deploy/auth.caddy
	import /etc/caddy/auth.caddy

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy no-referrer
		# 다른 곳의 스크립트·페이지 안 스크립트를 막음 → 화면에 이상한 글이 끼어들어도 로그인 토큰을 못 훔쳐 감 (XSS 방어).
		# 화면이 쓰는 것: 자기 서버 파일 · 인라인 style · QR 코드(data: 이미지). 바꾸면 frontend/e2e/smoke.mjs 의 CSP 테스트가 같이 확인
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self'; font-src 'self' data:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
		Cross-Origin-Opener-Policy same-origin
		-Server
	}

	handle /api/* {
		reverse_proxy backend:8000
	}

	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}
